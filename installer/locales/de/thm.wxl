  <String Id="FailureUnsafeUninstallHeader" Value="Deinstallation fehlgeschlagen" />
  <String Id="FailureHyperlinkLogText" Value="Ein oder mehrere Probleme haben das Setup scheitern lassen. Beheben Sie die Probleme und führen Sie das Setup erneut aus. Weitere Informationen finden Sie in der &lt;a href=&quot;#&quot;&gt;Protokolldatei&lt;/a&gt;." />
