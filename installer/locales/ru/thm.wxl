  <String Id="ProgressLabel" Value="Выполняется:" />
  <String Id="OverallProgressPackageText" Value="Подготовка..." />
  <String Id="ProgressCancelButton" Value="&amp;Отмена" />
  <String Id="ModifyHeader" Value="Изменение установки" />
  <String Id="ModifyRepairButton" Value="&amp;Восстановить" />
  <String Id="ModifyUninstallButton" Value="&amp;Удалить" />
  <String Id="ModifyCancelButton" Value="&amp;Отмена" />
