<?xml version="1.0" encoding="utf-8"?>
<!-- The WixStandardBootstrapperApplication theme strings in Russian. The ids
     match WiX 4's own RtfTheme.wxl; every one must be present, or the window
     shows the raw id. -->
<WixLocalization Culture="ru-RU" Language="1049" xmlns="http://wixtoolset.org/schemas/v4/wxl">
  <String Id="Caption" Value="Установка [WixBundleName]" />
  <String Id="Title" Value="[WixBundleName]" />
  <String Id="CheckingForUpdatesLabel" Value="Проверка обновлений" />
  <String Id="UpdateButton" Value="&amp;Обновить до версии [WixStdBAUpdateAvailable]" />
  <String Id="InstallVersion" Value="Версия [WixBundleVersion]" />
  <String Id="ConfirmCancelMessage" Value="Действительно отменить?" />
  <String Id="ExecuteUpgradeRelatedBundleMessage" Value="Предыдущая версия" />
  <String Id="HelpHeader" Value="Справка по установке" />
  <String Id="HelpText" Value="/install | /repair | /uninstall | /layout [каталог] — установка, восстановление, удаление или&#xA;   создание полной локальной копии пакета в каталоге. По умолчанию — установка.&#xA;&#xA;/passive | /quiet — минимальный интерфейс без вопросов или вообще без интерфейса&#xA;   и вопросов. По умолчанию показываются интерфейс и все вопросы.&#xA;&#xA;/norestart   — не перезагружать. По умолчанию перед перезагрузкой будет вопрос.&#xA;/log log.txt — журнал в указанный файл. По умолчанию журнал создаётся в %TEMP%." />
  <String Id="HelpCloseButton" Value="&amp;Закрыть" />
  <String Id="InstallAcceptCheckbox" Value="Я &amp;принимаю условия лицензии" />
  <String Id="InstallOptionsButton" Value="&amp;Параметры" />
  <String Id="InstallInstallButton" Value="&amp;Установить" />
  <String Id="InstallCancelButton" Value="&amp;Отмена" />
  <String Id="OptionsHeader" Value="Параметры установки" />
  <String Id="OptionsLocationLabel" Value="Папка установки:" />
  <String Id="OptionsBrowseButton" Value="&amp;Обзор" />
  <String Id="OptionsOkButton" Value="&amp;ОК" />
  <String Id="OptionsCancelButton" Value="&amp;Отмена" />
