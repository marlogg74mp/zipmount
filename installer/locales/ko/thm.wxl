  <String Id="SuccessInstallHeader" Value="설치를 완료했습니다" />
  <String Id="SuccessLayoutHeader" Value="로컬 복사본을 만들었습니다" />
  <String Id="SuccessModifyHeader" Value="수정을 완료했습니다" />
  <String Id="SuccessRepairHeader" Value="복구를 완료했습니다" />
