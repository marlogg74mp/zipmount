  <String Id="FilesInUseTitle" Value="사용 중인 파일" />
  <String Id="FilesInUseLabel" Value="다음 응용 프로그램이 업데이트해야 할 파일을 사용하고 있습니다:" />
  <String Id="FilesInUseNetfxCloseRadioButton" Value="응용 프로그램 닫기(&amp;A)." />
