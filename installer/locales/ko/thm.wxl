<?xml version="1.0" encoding="utf-8"?>
<!-- The WixStandardBootstrapperApplication theme strings in Korean. The ids
     match WiX 4's own RtfTheme.wxl; every one must be present, or the window
     shows the raw id. -->
<WixLocalization Culture="ko-KR" Language="1042" xmlns="http://wixtoolset.org/schemas/v4/wxl">
  <String Id="Caption" Value="[WixBundleName] 설치" />
  <String Id="Title" Value="[WixBundleName]" />
  <String Id="CheckingForUpdatesLabel" Value="업데이트 확인 중" />
  <String Id="UpdateButton" Value="버전 [WixStdBAUpdateAvailable](으)로 업데이트(&amp;U)" />
  <String Id="InstallVersion" Value="버전 [WixBundleVersion]" />
  <String Id="ConfirmCancelMessage" Value="취소하시겠습니까?" />
  <String Id="ExecuteUpgradeRelatedBundleMessage" Value="이전 버전" />
  <String Id="HelpHeader" Value="설치 도움말" />
  <String Id="HelpText" Value="/install | /repair | /uninstall | /layout [디렉터리] - 설치, 복구, 제거하거나&#xA;   디렉터리에 번들의 전체 로컬 복사본을 만듭니다. 기본값은 설치입니다.&#xA;&#xA;/passive | /quiet - 묻지 않고 최소한의 UI만 표시하거나, UI와 질문을 모두 표시하지 않습니다.&#xA;   기본적으로 UI와 모든 질문이 표시됩니다.&#xA;&#xA;/norestart   - 다시 시작하지 않습니다. 기본적으로 다시 시작하기 전에 묻습니다.&#xA;/log log.txt - 지정한 파일에 로그를 기록합니다. 기본적으로 %TEMP%에 로그 파일을 만듭니다." />
  <String Id="HelpCloseButton" Value="닫기(&amp;C)" />
  <String Id="InstallAcceptCheckbox" Value="사용 조건에 동의합니다(&amp;A)" />
  <String Id="InstallOptionsButton" Value="옵션(&amp;O)" />
  <String Id="InstallInstallButton" Value="설치(&amp;I)" />
  <String Id="InstallCancelButton" Value="취소(&amp;C)" />
  <String Id="OptionsHeader" Value="설치 옵션" />
  <String Id="OptionsLocationLabel" Value="설치 위치:" />
  <String Id="OptionsBrowseButton" Value="찾아보기(&amp;B)" />
  <String Id="OptionsOkButton" Value="확인(&amp;O)" />
  <String Id="OptionsCancelButton" Value="취소(&amp;C)" />
  <String Id="ProgressHeader" Value="설치 진행률" />
  <String Id="ProgressLabel" Value="처리 중:" />
  <String Id="OverallProgressPackageText" Value="초기화하는 중..." />
  <String Id="ProgressCancelButton" Value="취소(&amp;C)" />
  <String Id="ModifyHeader" Value="설치 수정" />
  <String Id="ModifyRepairButton" Value="복구(&amp;R)" />
  <String Id="ModifyUninstallButton" Value="제거(&amp;U)" />
