<?xml version="1.0" encoding="utf-8"?>
<!-- The WixStandardBootstrapperApplication theme strings in Brazilian
     Portuguese. The ids match WiX 4's own RtfTheme.wxl; every one must be
     present, or the window shows the raw id. -->
<WixLocalization Culture="pt-BR" Language="1046" xmlns="http://wixtoolset.org/schemas/v4/wxl">
  <String Id="Caption" Value="Instalação do [WixBundleName]" />
  <String Id="Title" Value="[WixBundleName]" />
  <String Id="CheckingForUpdatesLabel" Value="Procurando atualizações" />
  <String Id="UpdateButton" Value="&amp;Atualizar para a versão [WixStdBAUpdateAvailable]" />
  <String Id="InstallVersion" Value="Versão [WixBundleVersion]" />
  <String Id="ConfirmCancelMessage" Value="Tem certeza de que deseja cancelar?" />
  <String Id="ExecuteUpgradeRelatedBundleMessage" Value="Versão anterior" />
  <String Id="HelpHeader" Value="Ajuda da instalação" />
  <String Id="HelpText" Value="/install | /repair | /uninstall | /layout [pasta] - instala, repara, desinstala ou&#xA;   cria uma cópia local completa do pacote na pasta. Instalar é o padrão.&#xA;&#xA;/passive | /quiet - mostra uma interface mínima sem perguntas, ou nenhuma interface&#xA;   e nenhuma pergunta. Por padrão, a interface e todas as perguntas são exibidas.&#xA;&#xA;/norestart   - impede qualquer reinicialização. Por padrão, pergunta antes de reiniciar.&#xA;/log log.txt - grava o log em um arquivo específico. Por padrão, o log é criado em %TEMP%." />
  <String Id="HelpCloseButton" Value="&amp;Fechar" />
  <String Id="InstallAcceptCheckbox" Value="&amp;Concordo com os termos da licença" />
  <String Id="InstallOptionsButton" Value="&amp;Opções" />
  <String Id="InstallInstallButton" Value="&amp;Instalar" />
  <String Id="InstallCancelButton" Value="&amp;Cancelar" />
  <String Id="OptionsHeader" Value="Opções de instalação" />
  <String Id="OptionsLocationLabel" Value="Local de instalação:" />
  <String Id="OptionsBrowseButton" Value="&amp;Procurar" />
  <String Id="OptionsOkButton" Value="&amp;OK" />
  <String Id="OptionsCancelButton" Value="&amp;Cancelar" />
  <String Id="ProgressHeader" Value="Progresso da instalação" />
  <String Id="ProgressLabel" Value="Processando:" />
  <String Id="OverallProgressPackageText" Value="Inicializando..." />
  <String Id="ProgressCancelButton" Value="&amp;Cancelar" />
  <String Id="ModifyHeader" Value="Modificar a instalação" />
  <String Id="ModifyRepairButton" Value="&amp;Reparar" />
  <String Id="ModifyUninstallButton" Value="&amp;Desinstalar" />
  <String Id="ModifyCancelButton" Value="&amp;Cancelar" />
  <String Id="SuccessHeader" Value="Instalação concluída" />
  <String Id="SuccessCacheHeader" Value="Cache concluído com êxito" />
  <String Id="SuccessInstallHeader" Value="Instalação concluída com êxito" />
  <String Id="SuccessLayoutHeader" Value="Cópia local concluída com êxito" />
  <String Id="SuccessModifyHeader" Value="Modificação concluída com êxito" />
  <String Id="SuccessRepairHeader" Value="Reparo concluído com êxito" />
  <String Id="SuccessUninstallHeader" Value="Desinstalação concluída com êxito" />
  <String Id="SuccessUnsafeUninstallHeader" Value="Desinstalação concluída com êxito" />
  <String Id="SuccessLaunchButton" Value="&amp;Iniciar" />
  <String Id="SuccessRestartText" Value="É preciso reiniciar o computador antes de usar o software." />
  <String Id="SuccessUninstallRestartText" Value="É preciso reiniciar o computador para concluir a remoção do software." />
  <String Id="SuccessRestartButton" Value="&amp;Reiniciar" />
  <String Id="SuccessCloseButton" Value="&amp;Fechar" />
  <String Id="FailureHeader" Value="Falha na instalação" />
  <String Id="FailureCacheHeader" Value="Falha no cache" />
  <String Id="FailureInstallHeader" Value="Falha na instalação" />
  <String Id="FailureLayoutHeader" Value="Falha na cópia local" />
  <String Id="FailureModifyHeader" Value="Falha na modificação" />
  <String Id="FailureRepairHeader" Value="Falha no reparo" />
  <String Id="FailureUninstallHeader" Value="Falha na desinstalação" />
  <String Id="FailureUnsafeUninstallHeader" Value="Falha na desinstalação" />
  <String Id="FailureHyperlinkLogText" Value="Um ou mais problemas fizeram a instalação falhar. Corrija os problemas e tente instalar de novo. Para mais informações, veja o &lt;a href=&quot;#&quot;&gt;arquivo de log&lt;/a&gt;." />
  <String Id="FailureRestartText" Value="É preciso reiniciar o computador para concluir a reversão do software." />
  <String Id="FailureRestartButton" Value="&amp;Reiniciar" />
  <String Id="FailureCloseButton" Value="&amp;Fechar" />
  <String Id="FilesInUseTitle" Value="Arquivos em uso" />
